---
// Hand-drawn style line icons, stroke = currentColor.
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: className, label } = Astro.props;
const paths: Record<string, string> = {
  arrow: '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="m4 7.5 8 6 8-6"/>',
  venmo: '<rect x="2.5" y="5.5" width="19" height="13" rx="2.5"/><path d="M2.5 10h19"/><path d="M6.5 15h3.5"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  form: '<rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4"/>',
  envelope: '<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="m4 7.5 8 6 8-6"/>',
  wallet: '<path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H18v3"/><rect x="4" y="8" width="16" height="11" rx="2.5"/><circle cx="16" cy="13.5" r="1.1" fill="currentColor"/>',
  bag: '<path d="M5 8.5h14l-1 11a1.5 1.5 0 0 1-1.5 1.4h-9A1.5 1.5 0 0 1 6 19.5Z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>',
  heart: '<path d="M12 20s-7-4.3-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.7-7 10-7 10Z"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  // Product tile art (drawn at 64x64).
  cookie: '<circle cx="32" cy="32" r="22"/><path d="M24 22.5c1.2.8 1.9 1.9 1.6 3"/><circle cx="25" cy="34" r="2.6" fill="currentColor" stroke="none"/><circle cx="37" cy="25" r="2.4" fill="currentColor" stroke="none"/><circle cx="39" cy="38" r="2.8" fill="currentColor" stroke="none"/><circle cx="31" cy="43" r="1.9" fill="currentColor" stroke="none"/><circle cx="31" cy="29" r="1.6" fill="currentColor" stroke="none"/><path d="M46 18c2 1.6 3.6 3.8 4.6 6.3" stroke-dasharray="2 4"/>',
  brownie: '<rect x="12" y="18" width="40" height="30" rx="4"/><path d="M12 27c4 2.4 7-1.6 11 .4s7 2.6 10 .4 7-2.4 10-.4 6 1.4 9-.4"/><path d="M22 36l4 3M37 34l-3 4M42 41l3 1"/><path d="M18 54h28" stroke-dasharray="3 4"/>',
  bites: '<rect x="10" y="30" width="18" height="16" rx="3"/><rect x="34" y="30" width="18" height="16" rx="3"/><rect x="22" y="14" width="18" height="16" rx="3"/><path d="M14 34h10M38 34h10M26 18h10" stroke-dasharray="2 3"/>',
  loaf: '<path d="M12 30c0-7 9-12 20-12s20 5 20 12v16a4 4 0 0 1-4 4H16a4 4 0 0 1-4-4Z"/><path d="M22 24l3 6M31 22l2 6M40 24l-2 6"/><path d="M18 56h28" stroke-dasharray="3 4"/>',
  house: '<path d="M8 30 32 12l24 18"/><path d="M14 26v24h36V26"/><rect x="27" y="34" width="10" height="16"/><path d="M44 18v-6h5v10"/>',
};
const isTile = ['cookie', 'brownie', 'bites', 'loaf', 'house'].includes(name);
const vb = isTile ? '0 0 64 64' : '0 0 24 24';
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox={vb}
  fill="none"
  stroke="currentColor"
  stroke-width={isTile ? 2 : 1.7}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name] ?? ''}
/>
